{
  "id": "xml",
  "blocks": [],
  "foldPairs": [],
  "embedded": [],
  "name": "XML",
  "extensions": [
    "xml"
  ],
  "keywords": [],
  "lineComment": "",
  "blockCommentStart": "<!--",
  "blockCommentEnd": "-->",
  "multilineStrings": [],
  "caseSensitive": true,
  "folding": "markup",
  "rules": [
    {
