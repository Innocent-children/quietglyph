{
  "id": "bash",
  "blocks": [
    {
      "startPattern": "<<-?\\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)['\"]?",
      "endTemplate": "$1",
      "role": "string",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": true
    },
    {
      "startPattern": "'",
      "endTemplate": "'",
      "role": "string",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    },
    {
      "startPattern": "\"",
      "endTemplate": "\"",
      "role": "string",
      "escaped": true,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    }
  ],
  "foldPairs": [
    {
      "open": "(?:^|;)\\s*if\\b",
      "close": "\\bfi\\b"
    },
    {
      "open": "(?:^|;)\\s*(?:for|while|until|select)\\b",
      "close": "\\bdone\\b"
    },
    {
      "open": "(?:^|;)\\s*case\\b",
      "close": "\\besac\\b"
    }
  ],
  "embedded": [],
