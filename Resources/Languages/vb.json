{
  "id": "vb",
  "blocks": [
    {
      "startPattern": "\"",
      "endTemplate": "\"",
      "role": "string",
      "escaped": false,
      "doubled": true,
      "nested": false,
      "endAtLineStart": false
    }
  ],
  "foldPairs": [
    {
      "open": "^\\s*(?:(?:public|private|protected|static|shared)\\s+)*(?:sub|function|class|module|namespace|select\\s+case|while|for|do|if\\b.*\\bthen\\s*$)\\b",
      "close": "^\\s*(?:end\\s+(?:sub|function|class|module|namespace|select|while|if)|next|loop|wend)\\b"
    }
  ],
