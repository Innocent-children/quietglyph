{
  "id": "csharp",
  "blocks": [
    {
      "startPattern": "@\"",
      "endTemplate": "\"",
      "role": "string",
      "escaped": false,
      "doubled": true,
      "nested": false,
      "endAtLineStart": false
    },
    {
      "startPattern": "\"\"\"",
      "endTemplate": "\"\"\"",
      "role": "string",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    }
  ],
