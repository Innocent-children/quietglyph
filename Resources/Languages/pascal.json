{
  "id": "pascal",
  "blocks": [
    {
      "startPattern": "\\(\\*",
      "endTemplate": "*)",
      "role": "comment",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    },
    {
      "startPattern": "'",
      "endTemplate": "'",
      "role": "string",
      "escaped": false,
      "doubled": true,
      "nested": false,
      "endAtLineStart": false
    }
  ],
  "foldPairs": [
    {
      "open": "\\b(?:begin|case|record|try|object)\\b",
      "close": "\\bend\\b"
    }
  ],
  "embedded": [],
  "name": "Pascal",
  "extensions": [
    "pas"
  ],
