{
  "id": "coffeescript",
  "blocks": [
    {
      "startPattern": "###",
      "endTemplate": "###",
      "role": "comment",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    },
    {
      "startPattern": "\"\"\"",
      "endTemplate": "\"\"\"",
      "role": "string",
      "escaped": true,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    },
    {
      "startPattern": "'''",
      "endTemplate": "'''",
      "role": "string",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    }
  ],
  "foldPairs": [],
  "embedded": [],
  "name": "CoffeeScript",
  "extensions": [
    "coffee"
  ],
  "keywords": [
    "and",
    "break",
    "by",
    "catch",
    "class",
    "continue",
    "debugger",
    "delete",
    "do",
    "else",
    "extends",
    "false",
    "finally",
    "for",
    "if",
    "in",
    "instanceof",
    "is",
    "isnt",
    "loop",
    "new",
    "no",
    "not",
    "null",
    "of",
    "off",
    "on",
    "or",
    "return",
    "super",
    "switch",
    "then",
    "this",
    "throw",
    "true",
    "try",
    "typeof",
    "undefined",
    "unless",
    "until",
    "when",
    "while",
    "yes"
  ],
  "lineComment": "#",
  "blockCommentStart": "",
  "blockCommentEnd": "",
  "multilineStrings": [],
  "caseSensitive": true,
  "folding": "indent",
  "rules": []
}
