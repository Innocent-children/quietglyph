{
  "id": "fortran77",
  "blocks": [
    {
      "startPattern": "'",
      "endTemplate": "'",
      "role": "string",
      "escaped": false,
      "doubled": true,
      "nested": false,
      "endAtLineStart": false
    },
    {
      "startPattern": "\"",
      "endTemplate": "\"",
      "role": "string",
      "escaped": false,
      "doubled": true,
      "nested": false,
      "endAtLineStart": false
    }
  ],
  "foldPairs": [
    {
      "open": "^\\s*(?:(?:recursive|pure|elemental|integer|real|logical|character|double\\s+precision)\\s+)*(?:program|module(?!\\s+procedure)|subroutine|function|do|select\\s+case|if.*then\\s*$|type\\s*::)\\b",
      "close": "^\\s*(?:end(?:\\s*(?:program|module|subroutine|function|do|select|if|type))?|enddo|endif)\\b"
    }
  ],
  "embedded": [],
  "name": "Fortran77",
