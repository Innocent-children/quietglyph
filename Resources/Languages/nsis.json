{
  "id": "nsis",
  "blocks": [
    {
      "startPattern": "/\\*",
      "endTemplate": "*/",
      "role": "comment",
      "escaped": false,
      "doubled": false,
      "nested": false,
      "endAtLineStart": false
    }
  ],
  "foldPairs": [
    {
      "open": "^\\s*Section\\b",
      "close": "^\\s*SectionEnd\\b"
    },
    {
      "open": "^\\s*Function\\b",
      "close": "^\\s*FunctionEnd\\b"
    },
    {
      "open": "^\\s*!macro\\b",
      "close": "^\\s*!macroend\\b"
    },
    {
      "open": "^\\s*!if(?:def|ndef)?\\b",
      "close": "^\\s*!endif\\b"
    }
  ],
  "embedded": [],
  "name": "NSIS",
  "extensions": [
    "nsh",
    "nsi"
  ],
